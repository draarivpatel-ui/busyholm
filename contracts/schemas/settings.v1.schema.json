{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://busyholm.invalid/contracts/settings.v1.schema.json",
  "title": "Settings v1",
  "description": "settings.json in the app data folder (SPEC 6.9). Written only by the core, atomically. Every group is required so a settings file is always complete; the app writes the defaults on first run. Actions (connect or disconnect hooks, Delete everything) are not settings: hook and status line state lives in InstallManifest v1. Muting a single agent from its card lasts for that session only and is not stored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strip",
    "sky",
    "sound",
    "notifications",
    "ambient",
    "agents",
    "privacy",
    "other",
    "updates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "strip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "display",
        "height",
        "layer_mode",
        "hover_fade",
        "show_over_fullscreen"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Default true."
        },
        "display": {
          "description": "auto: the display with the Dock or taskbar, else the primary (default). named: a specific display by its OS name.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "auto"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "name"
              ],
              "properties": {
                "mode": {
                  "const": "named"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
                }
              }
            }
          ]
        },
        "height": {
          "type": "integer",
          "minimum": 72,
          "maximum": 160,
          "description": "Logical pixels; default 112."
        },
        "layer_mode": {
          "enum": [
            "on_top",
            "behind_windows",
            "reserve_space"
          ],
          "description": "Default on_top. reserve_space exists only on Windows, X11 and layer-shell compositors; elsewhere the app falls back to on_top."
        },
        "hover_fade": {
          "type": "boolean",
          "description": "Default true."
        },
        "show_over_fullscreen": {
          "type": "boolean",
          "description": "Default false."
        }
      }
    },
    "sky": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "hemisphere"
      ],
      "properties": {
        "mode": {
          "enum": [
            "usage_and_clock",
            "clock_only"
          ],
          "description": "Default usage_and_clock."
        },
        "hemisphere": {
          "enum": [
            "north",
            "south"
          ],
          "description": "Default north."
        }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bell",
        "volume",
        "quiet_hours"
      ],
      "properties": {
        "bell": {
          "type": "boolean",
          "description": "Default true."
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Default 0.7 (a WP-01 choice; WP-11 may tune it)."
        },
        "quiet_hours": {
          "description": "Local times; the range may cross midnight. null means off (default).",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "$ref": "#/$defs/hhmm"
                },
                "end": {
                  "$ref": "#/$defs/hhmm"
                }
              }
            }
          ]
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs_you",
        "renotify",
        "long_turn",
        "errors"
      ],
      "description": "All default true. The durations are fixed by SPEC 6.9: re-notify after 5 min, long turn means over 2 min.",
      "properties": {
        "needs_you": {
          "type": "boolean"
        },
        "renotify": {
          "type": "boolean"
        },
        "long_turn": {
          "type": "boolean"
        },
        "errors": {
          "type": "boolean"
        }
      }
    },
    "ambient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idle_minutes",
        "shortcut"
      ],
      "properties": {
        "idle_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 5,
              "maximum": 60
            },
            {
              "type": "null"
            }
          ],
          "description": "Minutes without input before ambient mode starts; null means off. Default null: ambient is manual until a per-display fullscreen check is verified on that OS (SPEC Revision 1, item 5)."
        },
        "shortcut": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9]+(\\+[A-Za-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Global shortcut accelerator such as CommandOrControl+Shift+B; null means none."
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species"
      ],
      "properties": {
        "species": {
          "type": "object",
          "description": "Species overrides per tool; a tool not listed uses the SPEC 4.2 default.",
          "propertyNames": {
            "$ref": "#/$defs/tool"
          },
          "additionalProperties": {
            "$ref": "#/$defs/species"
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_names",
        "history_backfill"
      ],
      "properties": {
        "project_names": {
          "type": "boolean",
          "description": "Default false. When true, only the last folder segment is shown, and never written to the ledger."
        },
        "history_backfill": {
          "type": "boolean",
          "description": "Default false."
        }
      }
    },
    "other": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_at_login",
        "reduced_motion"
      ],
      "properties": {
        "launch_at_login": {
          "type": "boolean",
          "description": "Default false; onboarding offers to turn it on (a WP-01 choice)."
        },
        "reduced_motion": {
          "enum": [
            "follow_os",
            "always"
          ],
          "description": "Default follow_os."
        }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check"
      ],
      "properties": {
        "check": {
          "type": "boolean",
          "description": "Direct-download builds only (SPEC 6.10): one GET of a static manifest. Default false; Steam builds ignore it."
        }
      }
    }
  },
  "$defs": {
    "tool": {
      "enum": [
        "claude",
        "codex",
        "opencode",
        "antigravity",
        "gemini",
        "cursor",
        "aider",
        "other"
      ]
    },
    "species": {
      "enum": [
        "beaver",
        "otter",
        "frog",
        "hare",
        "mole",
        "heron",
        "hedgehog"
      ]
    },
    "hhmm": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  }
}
