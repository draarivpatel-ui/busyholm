{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/someone/.othertool/plugin/scripts/session-start.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/someone/.othertool/plugin/scripts/session-end.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
